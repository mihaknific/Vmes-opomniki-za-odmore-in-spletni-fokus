{
  "manifest_version": 3,
  "name": "Vmes: opomniki za odmore in spletni fokus",
  "version": "0.9.2",
  "description": "Firefoxovi opomniki za oči, vodo in odmore ter spletni fokus z omejitvami in blokiranjem. Brez računa ali analitike; podatki ostanejo lokalno.",
  "author": "Miha Knific",
  "homepage_url": "https://mihaknific.github.io/Vmes-opomniki-za-odmore-in-spletni-fokus/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vmes: opomniki za odmore in spletni fokus",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "lib/core.js",
      "lib/icons.js",
      "background.js"
    ]
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*.ogg",
        "fonts/*.ttf"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+N"
      },
      "description": "Odpri Vmes: opomnike za odmore in spletni fokus"
    },
    "add-reminder": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Dodaj opomnik"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "id": "web-nudge@firefox"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
